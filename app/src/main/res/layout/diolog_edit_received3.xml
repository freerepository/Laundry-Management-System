                        android:gravity="center"
                        android:text="Pre Qty"
                        android:textColor="@color/black"
                        android:textSize="12sp"
                        app:tint="@color/colorWhite" />

                    <EditText
                        android:id="@+id/et_qty_face_towel_d"
                        android:layout_width="match_parent"
                        android:layout_height="30dp"
                        android:layout_weight="1"
                        android:background="@drawable/shape_circle_dialog_edit_border"
                        android:gravity="center"
                        android:hint="value"
                        android:textColorHint="@color/hint_color"
                        android:inputType="number"
                        android:textColor="@color/black"
                        android:textSize="12sp"
                        app:tint="@color/colorWhite" />
                    <EditText
                        android:id="@+id/et_qty_face_towel_d_unUsed"
                        android:layout_width="match_parent"
                        android:layout_height="30dp"
                        android:layout_weight="1"
                        android:background="@drawable/shape_circle_dialog_edit_border"
                        android:gravity="center"
                        android:hint="value"
                        android:textColorHint="@color/hint_color"
                        android:layout_marginStart="5dp"
                        android:inputType="number"
                        android:textColor="@color/black"
                        android:textSize="12sp"
                        app:tint="@color/colorWhite" />

                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/_16sdp"
                android:layout_marginTop="@dimen/_2sdp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                app:layout_constraintTop_toBottomOf="@+id/ll_uid">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvremarkd"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginVertical="@dimen/_8sdp"
                        android:text="Remark:"
                        android:textColor="@color/black"
                        android:textSize="12sp"
                        app:tint="@color/colorWhite" />

                    <EditText
                        android:id="@+id/et_remarkd"
                        android:layout_width="fill_parent"
                        android:layout_height="50sp"
                        android:gravity="top|left"
                        android:inputType="textEmailAddress|textMultiLine"
                        android:lines="20"
                        android:hint="Write something...."
                        android:minLines="5"
                        android:textSize="13sp"
                        android:textColorHint="@color/colorHint"
                        android:textColor="@android:color/black"
                        android:background="@drawable/shape_circle"
                        android:scrollHorizontally="false"
                        android:scrollbars="vertical" />

                </LinearLayout>


            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_4sdp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/v_negative"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/_30sdp"
                    android:layout_margin="@dimen/_16sdp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_corner8"
                    android:backgroundTint="@android:color/holo_red_dark"
                    android:elevation="@dimen/_2sdp"
                    android:fontFamily="@font/droid_serif"
                    android:gravity="center"
                    android:text="Cancel"
                    android:textColor="@android:color/white" />

                <TextView
                    android:id="@+id/v_positive"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/_30sdp"
                    android:layout_margin="@dimen/_16sdp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_corner8"
                    android:backgroundTint="@color/colorGreen"
                    android:elevation="@dimen/_2sdp"
                    android:fontFamily="@font/droid_serif"
                    android:gravity="center"
                    android:text="Save"
                    android:textColor="@android:color/white" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>