<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="4dp"
    android:paddingBottom="4dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:background="@drawable/btn1"
    android:layout_margin="1dp"
    android:elevation="@dimen/_4sdp"
    android:minHeight="60dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <TextView
                android:id="@+id/tv_index"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textSize="10dp"
                android:layout_weight="1"
                android:gravity="center"
                android:textColor="#000000"
                android:layout_margin="2dp"
                android:textAppearance="@android:style/TextAppearance.Medium"
                android:text="1"/>

            <TextView
                    android:id="@+id/tv_date"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:textSize="12dp"
                    android:layout_weight="2.5"
                    android:gravity="center"
                    android:textColor="#000000"
                    android:layout_margin="2dp"
                    android:textAppearance="@android:style/TextAppearance.Medium"
                    android:text="date"/>
                <TextView
                    android:id="@+id/tv_laundry_area"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:textSize="12dp"
                    android:layout_weight="2.5"
                    android:gravity="center"
                    android:textColor="#000000"
                    android:layout_margin="2dp"
                    android:textAppearance="@android:style/TextAppearance.Medium"
                    android:text="depot name "/>
                <TextView
                    android:id="@+id/tv_total_item"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:textSize="12dp"
                    android:layout_weight="3"
                    android:textColor="#000000"
                    android:layout_margin="2dp"
                    android:visibility="gone"
                    android:gravity="center"
                    android:textAppearance="@android:style/TextAppearance.Medium"
                    android:text="Total item"/>

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/tv_status"
                    android:layout_width="0dp"
                    android:layout_height="22dp"
                    android:textSize="12dp"
                    android:layout_weight="2.5"
                    android:textColor="#000000"
                    android:layout_margin="2dp"
                    android:background="@drawable/button_orange_bg"
                    android:gravity="center"
                    android:textAppearance="@android:style/TextAppearance.Medium"
                    android:text="Status"/>


                <ImageView
                    android:id="@+id/iv_qr_code"
                    android:layout_width="0dp"
                    android:layout_height="22dp"
                    android:textSize="1dp"
                    android:layout_weight="1.5"
                    android:gravity="center"
                    android:textColor="#000000"
                    android:layout_margin="3dp"
                    android:paddingRight="5dp"
                    android:src="@drawable/qr_code_scan"
                    android:textAppearance="@android:style/TextAppearance.Medium"
                    android:text=""/>

        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/background"
            android:layout_weight="1">

            <TextView
                android:id="@+id/tv_b1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textSize="10dp"
                android:layout_weight="3"
                android:gravity="end|center_horizontal"
                android:textColor="#000000"
                android:layout_margin="2dp"
                android:textAppearance="@android:style/TextAppearance.Medium"
                android:text="Train :"/>
            <TextView
                android:id="@+id/tv_trainNo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textSize="10dp"
                android:layout_weight="4.2"
                android:textColor="#000000"
                android:layout_margin="2dp"
                android:textAppearance="@android:style/TextAppearance.Medium"
                android:text="0"/>
            <TextView
                android:id="@+id/tv_b2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textSize="10dp"
                android:layout_weight="3"
                android:gravity="end|center_horizontal"
                android:textColor="#000000"
                android:layout_margin="2dp"
                android:textAppearance="@android:style/TextAppearance.Medium"
                android:text="Coach :"/>
            <TextView
                android:id="@+id/tv_coach"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textSize="10dp"
                android:layout_weight="3"
                android:textColor="#000000"
                android:layout_margin="2dp"
                android:textAppearance="@android:style/TextAppearance.Medium"
                android:text="0"/>

            <TextView
                android:id="@+id/tv_b4"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textSize="10dp"
                android:layout_weight="2"
                android:gravity="end|center_horizontal"
                android:textColor="#000000"
                android:layout_margin="2dp"
                android:textAppearance="@android:style/TextAppearance.Medium"
                android:text="BS :"/>
            <TextView
                android:id="@+id/tv_bed_sheet"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textSize="10dp"
                android:layout_weight="1.8"
                android:textColor="#000000"
                android:layout_margin="2dp"
                android:textAppearance="@android:style/TextAppearance.Medium"
                android:text="0"/>

            <TextView
                android:id="@+id/tv_b9"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textSize="10dp"
                android:layout_weight="3"
                android:textColor="#000000"
                android:layout_margin="2dp"
                android:gravity="end|center_horizontal"
                android:textAppearance="@android:style/TextAppearance.Medium"
                android:text="Blanket :"/>
            <TextView
                android:id="@+id/tv_blanket"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textSize="10dp"
                android:layout_weight="1.8"
                android:textColor="#000000"
                android:layout_margin="2dp"
                android:textAppearance="@android:style/TextAppearance.Medium"
                android:text="0"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/background"
            android:layout_weight="1">



            <TextView
                android:id="@+id/tv_p5"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textSize="10dp"
                android:layout_weight="2.5"
                android:gravity="end|center_horizontal"
                android:textColor="#000000"
                android:layout_margin="2dp"
                android:textAppearance="@android:style/TextAppearance.Medium"
                android:text="PC :"/>
            <TextView
                android:id="@+id/tv_pillow_cover"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textSize="10dp"
                android:layout_weight="4"
                android:textColor="#000000"
                android:layout_margin="2dp"
                android:textAppearance="@android:style/TextAppearance.Medium"
                android:text="0"/>
            <TextView
                android:id="@+id/tv_p6"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textSize="10dp"
                android:layout_weight="2.1"
                android:gravity="end|center_horizontal"
                android:textColor="#000000"
                android:layout_margin="2dp"
                android:textAppearance="@android:style/TextAppearance.Medium"
                android:text="BT :"/>
            <TextView
                android:id="@+id/tv_bath_towel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textSize="10dp"
                android:layout_weight="2.3"
                android:textColor="#000000"
                android:layout_margin="2dp"
                android:textAppearance="@android:style/TextAppearance.Medium"
                android:text="0"/>

            <TextView
                android:id="@+id/tv_p7"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textSize="10dp"
                android:layout_weight="2"
                android:textColor="#000000"
                android:layout_margin="2dp"
                android:gravity="end|center_horizontal"
                android:textAppearance="@android:style/TextAppearance.Medium"
                android:text="BC :"/>
            <TextView
                android:id="@+id/tv_blanket_cover"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textSize="10dp"
                android:layout_weight="2"
                android:textColor="#000000"
                android:layout_margin="2dp"
                android:textAppearance="@android:style/TextAppearance.Medium"
                android:text="0"/>

            <TextView
                android:id="@+id/tv_b8"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textSize="10dp"
                android:layout_weight="2"
                android:textColor="#000000"
                android:layout_margin="2dp"
                android:gravity="end|center_horizontal"
                android:textAppearance="@android:style/TextAppearance.Medium"
                android:text="FC :"/>
            <TextView
                android:id="@+id/tv_face_towel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textSize="10dp"
                android:layout_weight="1.5"
                android:textColor="#000000"
                android:layout_margin="2dp"
                android:textAppearance="@android:style/TextAppearance.Medium"
                android:text="0"/>
        </LinearLayout>


    </LinearLayout>


</LinearLayout>
