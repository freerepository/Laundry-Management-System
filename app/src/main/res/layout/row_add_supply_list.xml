<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="4dp"
    android:paddingBottom="4dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:background="@drawable/btn1"
    android:layout_margin="1dp"
    android:elevation="@dimen/_5sdp"
    android:minHeight="48dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <TextView
                android:id="@+id/tv_serial_no"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:layout_weight="1"
                android:textSize="12dp"
                android:layout_marginTop="3dp"
                android:textAppearance="@android:style/TextAppearance.Medium"
                android:textColor="@android:color/black"
                android:text="1"/>

    <TextView
        android:id="@+id/tv_date"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textSize="12dp"
        android:layout_weight="3.2"
        android:gravity="center"
        android:textColor="#000000"
        android:layout_margin="2dp"
        android:textAppearance="@android:style/TextAppearance.Medium"
        android:text="date"/>
    <TextView
        android:id="@+id/tv_depot_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textSize="12dp"
        android:layout_weight="2"
        android:textColor="#000000"
        android:layout_margin="2dp"
        android:gravity="center"
        android:textAppearance="@android:style/TextAppearance.Medium"
        android:text="Depot"/>
    <TextView
        android:id="@+id/tv_train_no"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textSize="12dp"
        android:layout_weight="3.5"
        android:textColor="#000000"
        android:layout_margin="2dp"
        android:gravity="center"
        android:textAppearance="@android:style/TextAppearance.Medium"
        android:text="Train No"/>

    <TextView
        android:id="@+id/tv_packet_count"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textSize="12dp"
        android:layout_weight="3"
        android:textColor="#000000"
        android:layout_margin="2dp"
        android:gravity="center"
        android:textAppearance="@android:style/TextAppearance.Medium"
        android:text="Packets"/>

    <TextView
        android:id="@+id/tv_verify"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textSize="15dp"
        android:layout_weight="3"
        android:textColor="#4CAF50"
        android:layout_margin="2dp"
        android:gravity="center"
        android:textStyle="bold"
        android:textAppearance="@android:style/TextAppearance.Medium"
        android:text="Verify"/>
        </LinearLayout>
        <LinearLayout
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/background"
            android:layout_weight="1">

            <TextView
                android:id="@+id/tv_b2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textSize="10dp"
                android:layout_weight="2.3"
                android:gravity="end|center_horizontal"
                android:textColor="#000000"
                android:layout_margin="2dp"
                android:textAppearance="@android:style/TextAppearance.Medium"
                android:text="Coach :"/>
            <TextView
                android:id="@+id/tv_coach"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textSize="10dp"
                android:layout_weight="3"
                android:textColor="#000000"
                android:layout_margin="2dp"
                android:textAppearance="@android:style/TextAppearance.Medium"
                android:text="0"/>
            <TextView
                android:id="@+id/tv_p3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textSize="10dp"
                android:layout_weight="2"
                android:gravity="end|center_horizontal"
                android:textColor="#000000"
                android:layout_margin="2dp"
                android:textAppearance="@android:style/TextAppearance.Medium"
                android:text="No Bag :"/>
            <TextView
                android:id="@+id/tv_no_of_bag"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textSize="10dp"
                android:layout_weight="1.8"
                android:textColor="#000000"
                android:layout_margin="2dp"
                android:textAppearance="@android:style/TextAppearance.Medium"
                android:text="0"/>
            <TextView
                android:id="@+id/tv_p4"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textSize="10dp"
                android:layout_weight="2"
                android:gravity="end|center_horizontal"
                android:textColor="#000000"
                android:layout_margin="2dp"
                android:textAppearance="@android:style/TextAppearance.Medium"
                android:text="BS :"/>
            <TextView
                android:id="@+id/tv_bed_sheet"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textSize="10dp"
                android:layout_weight="1.8"
                android:textColor="#000000"
                android:layout_margin="2dp"
                android:textAppearance="@android:style/TextAppearance.Medium"
                android:text="0"/>
            <TextView
                android:id="@+id/tv_p5"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textSize="10dp"
                android:layout_weight="2"
                android:textColor="#000000"
                android:layout_margin="2dp"
                android:gravity="end|center_horizontal"
                android:textAppearance="@android:style/TextAppearance.Medium"
                android:text="PC :"/>
            <TextView
                android:id="@+id/tv_pillow_cover"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textSize="10dp"
                android:layout_weight="1.8"
                android:textColor="#000000"
                android:layout_margin="2dp"
                android:textAppearance="@android:style/TextAppearance.Medium"
                android:text="0"/>

        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/background"
            android:visibility="gone"
            android:layout_weight="1">


            <TextView
                android:id="@+id/tv_p6"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textSize="10dp"
                android:layout_weight="1.8"
                android:textColor="#000000"
                android:layout_margin="2dp"
                android:gravity="end|center_horizontal"
                android:textAppearance="@android:style/TextAppearance.Medium"
                android:text="BT :"/>
            <TextView
                android:id="@+id/tv_bath_towel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textSize="10dp"
                android:layout_weight="1.8"
                android:textColor="#000000"
                android:layout_margin="2dp"
                android:textAppearance="@android:style/TextAppearance.Medium"
                android:text="0"/>
            <TextView
                android:id="@+id/tv_p7"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textSize="10dp"
                android:layout_weight="3"
                android:textColor="#000000"
                android:layout_margin="2dp"
                android:gravity="end|center_horizontal"
                android:textAppearance="@android:style/TextAppearance.Medium"
                android:text="BC :"/>
            <TextView
                android:id="@+id/tv_blanket_cover"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textSize="10dp"
                android:layout_weight="1.8"
                android:textColor="#000000"
                android:layout_margin="2dp"
                android:textAppearance="@android:style/TextAppearance.Medium"
                android:text="0"/>

            <TextView
                android:id="@+id/tv_p8"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textSize="10dp"
                android:layout_weight="3"
                android:textColor="#000000"
                android:layout_margin="2dp"
                android:gravity="end|center_horizontal"
                android:textAppearance="@android:style/TextAppearance.Medium"
                android:text="FT :"/>
            <TextView
                android:id="@+id/tv_face_towel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textSize="10dp"
                android:layout_weight="1.8"
                android:textColor="#000000"
                android:layout_margin="2dp"
                android:textAppearance="@android:style/TextAppearance.Medium"
                android:text="0"/>
            <TextView
                android:id="@+id/tv_p9"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textSize="10dp"
                android:layout_weight="2.5"
                android:textColor="#000000"
                android:layout_margin="2dp"
                android:gravity="end|center_horizontal"
                android:textAppearance="@android:style/TextAppearance.Medium"
                android:text="BLK :"/>
            <TextView
                android:id="@+id/tv_blanket"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textSize="10dp"
                android:layout_weight="1.8"
                android:textColor="#000000"
                android:layout_margin="2dp"
                android:textAppearance="@android:style/TextAppearance.Medium"
                android:text="0"/>


        </LinearLayout>
    </LinearLayout>

</LinearLayout>
