<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    app:layout_behavior="@string/appbar_scrolling_view_behavior">
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/include">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/title_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:minHeight="40dp"
                android:padding="4dp"
                android:background="#eeeeee"
                android:gravity="center">

                <TextView
                    android:text="Officer's Name :"
                    android:layout_weight="0.2"
                    android:padding="5dp"
                    android:textSize="18dp"
                    style="@style/textBothBlack"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@android:style/TextAppearance.Large"/>
                <TextView
                    android:id="@+id/tvUserName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.7"
                    android:padding="5dp"
                    android:textSize="18dp"
                    android:textAppearance="@android:style/TextAppearance.Large"/>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="40dp"
                style="@style/border"
                android:layout_margin="10dp"
                android:id="@+id/design4">
                <Spinner
                    android:id="@+id/sp_selectdepot"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    style="@style/spinnerbackground"
                    android:padding="5dp" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="40dp"
                style="@style/border"
                android:layout_margin="10dp"
                android:id="@+id/design">
                <Spinner
                    android:id="@+id/sp_laundry"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    style="@style/spinnerbackground"
                    android:padding="5dp" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="40dp"
                style="@style/border"
                android:layout_margin="10dp"
                android:id="@+id/design1">
                <Spinner
                    android:id="@+id/sp_designation"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    style="@style/spinnerbackground"
                    android:padding="5dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="40dp"
                style="@style/border"
                android:layout_margin="10dp"
                android:layout_below="@+id/design"
                android:id="@+id/design2">

                <Spinner
                    android:id="@+id/sp_grade"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    style="@style/spinnerbackground"
                    android:padding="5dp" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="10dp"
                android:id="@+id/radio"
                android:orientation="vertical"
                android:layout_below="@+id/design2">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:paddingTop="5dp"
                    android:paddingBottom="5dp"
                    android:background="@color/colorBlueDark"
                    android:layout_weight="1"
                    android:textColor="@android:color/white"
                    android:gravity="center"
                    android:textSize="15sp"
                    android:text="Ratings:"/>

                <RadioGroup
                    android:id="@+id/Radio_group"
                    android:layout_marginTop="10dp"
                    android:layout_below="@id/card_view"
                    android:weightSum="5"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" >
                    <RadioButton
                        android:layout_weight="1"
                        android:id="@+id/rb1"
                        style="@style/text"
                        android:text="10"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                    <RadioButton
                        android:layout_weight="1"
                        android:id="@+id/rb2"
                        android:text="8"
                        style="@style/text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                    <RadioButton
                        android:layout_weight="1"
                        android:id="@+id/rb3"
                        android:text="6"
                        style="@style/text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                    <RadioButton
                        android:layout_weight="1"
                        android:id="@+id/rb4"
                        style="@style/text"
                        android:text="4"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                    <RadioButton
                        android:layout_weight="1"
                        android:id="@+id/rb5"
                        style="@style/text"
                        android:text="2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                </RadioGroup>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:weightSum="2"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/lamount"
                android:layout_below="@+id/radio">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="24sp"
                    android:layout_weight="1"
                    android:layout_margin="8dp"
                    style="@style/text"
                    android:text="Amount :"/>

                <EditText
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="24sp"
                    android:id="@+id/amount"
                    android:layout_weight="1"
                    android:inputType="number"
                    style="@style/text"
                    android:hint="@string/ruppee_text"/>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:orientation="vertical"
                android:id="@+id/rmark"
                android:layout_below="@+id/radio">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="20sp"
                    style="@style/text"
                    android:contentDescription="@string/Officer"
                    android:text="Remark : "/>

                <EditText
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="20sp"
                    android:id="@+id/remark"
                    android:scrollbars="vertical"
                    style="@style/text"
                    android:hint="Write Something"/>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/rmark"
                android:layout_marginTop="1dp"
                android:gravity="center"
                android:orientation="vertical">

                <Button
                    android:id="@+id/rating"
                    android:layout_width="250dp"
                    android:layout_height="wrap_content"
                    android:layout_margin="10dp"
                    android:layout_weight="1"
                    android:background="@drawable/button_blue_bg"
                    android:text="Submit"
                    android:textAppearance="@style/TextAppearance.AppCompat.Medium"
                    android:textColor="@android:color/white"
                    android:visibility="visible" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
    <include
        android:id="@+id/include"
        android:layout_alignParentBottom="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        layout="@layout/bottom_layout"/>

</RelativeLayout>