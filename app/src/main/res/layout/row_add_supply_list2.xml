<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="1dp"
    android:background="@drawable/btn1"
    android:elevation="@dimen/_5sdp"
    android:gravity="center_vertical"
    android:minHeight="48dp"
    android:orientation="horizontal"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1">

            <TextView
                android:id="@+id/tv_index_number"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:text="1"
                android:textAppearance="@android:style/TextAppearance.Medium"
                android:textColor="@android:color/black"
                android:textSize="12dp" />

            <TextView
                android:id="@+id/tv_date"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="2dp"
                android:layout_weight="3.2"
                android:gravity="center"
                android:text="date"
                android:textAppearance="@android:style/TextAppearance.Medium"
                android:textColor="#000000"
                android:textSize="12dp" />

            <TextView
                android:id="@+id/tv_laundry"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="2dp"
                android:layout_weight="3"
                android:gravity="center"
                android:text="Depot"
                android:textAppearance="@android:style/TextAppearance.Medium"
                android:textColor="#000000"
                android:textSize="12dp" />

            <TextView
                android:id="@+id/tv_train_no"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="2dp"
                android:layout_weight="3.5"
                android:gravity="center"
                android:text="Train No"
                android:visibility="gone"
                android:textAppearance="@android:style/TextAppearance.Medium"
                android:textColor="#000000"
                android:textSize="12dp" />

            <!--yaha tv coach par train number diya gaya hai-->
            <TextView
                android:id="@+id/tv_coach"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="3"
                android:gravity="center"
                android:paddingLeft="5dp"
                android:paddingRight="5dp"
                android:text="A1"
                android:textAppearance="@android:style/TextAppearance.Medium"
                android:textColor="@android:color/black"
                android:textSize="13dp" />

            <TextView
                android:id="@+id/tv_total"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="2dp"
                android:layout_weight="2"
                android:gravity="center"
                android:text="Packets"
                android:textAppearance="@android:style/TextAppearance.Medium"
                android:textColor="#000000"
                android:textSize="12dp" />

            <TextView
                android:id="@+id/iv_view"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="2dp"
                android:layout_weight="3"
                android:gravity="center"
                android:text="Verify"
                android:textAppearance="@android:style/TextAppearance.Medium"
                android:textColor="#4CAF50"
                android:textSize="15dp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@color/background">

            <TextView
                android:id="@+id/tv_b2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="2dp"
                android:layout_weight="2.3"
                android:gravity="end|center_horizontal"
                android:text="Coach :"
                android:textAppearance="@android:style/TextAppearance.Medium"
                android:textColor="#000000"
                android:textSize="10dp" />

            <TextView
                android:id="@+id/tv_coach1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="2dp"
                android:layout_weight="3"
                android:text="0"
                android:textAppearance="@android:style/TextAppearance.Medium"
                android:textColor="#000000"
                android:textSize="10dp" />

            <TextView
                android:id="@+id/tv_p3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="2dp"
                android:layout_weight="2"
                android:gravity="end|center_horizontal"
                android:text="No Bag :"
                android:textAppearance="@android:style/TextAppearance.Medium"
                android:textColor="#000000"
                android:textSize="10dp" />

            <TextView
                android:id="@+id/tv_no_of_bag"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="2dp"
                android:layout_weight="1.8"
                android:text="0"
                android:textAppearance="@android:style/TextAppearance.Medium"
                android:textColor="#000000"
                android:textSize="10dp" />

            <TextView
                android:id="@+id/tv_p4"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="2dp"
                android:layout_weight="2"
                android:gravity="end|center_horizontal"
                android:text="BS :"
                android:textAppearance="@android:style/TextAppearance.Medium"
                android:textColor="#000000"
                android:textSize="10dp" />

            <TextView
                android:id="@+id/tv_bed_sheet"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="2dp"
                android:layout_weight="1.8"
                android:text="0"
                android:textAppearance="@android:style/TextAppearance.Medium"
                android:textColor="#000000"
                android:textSize="10dp" />

            <TextView
                android:id="@+id/tv_p5"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="2dp"
                android:layout_weight="2"
                android:gravity="end|center_horizontal"
                android:text="PC :"
                android:textAppearance="@android:style/TextAppearance.Medium"
                android:textColor="#000000"
                android:textSize="10dp" />

            <TextView
                android:id="@+id/tv_pillow_cover"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="2dp"
                android:layout_weight="1.8"
                android:text="0"
                android:textAppearance="@android:style/TextAppearance.Medium"
                android:textColor="#000000"
                android:textSize="10dp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@color/background">


            <TextView
                android:id="@+id/tv_p6"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="2dp"
                android:layout_weight="1.8"
                android:gravity="end|center_horizontal"
                android:text="PLW :"
                android:textAppearance="@android:style/TextAppearance.Medium"
                android:textColor="#000000"
                android:textSize="10dp" />

            <TextView
                android:id="@+id/tv_bath_towel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="2dp"
                android:layout_weight="1.8"
                android:text="0"
                android:textAppearance="@android:style/TextAppearance.Medium"
                android:textColor="#000000"
                android:textSize="10dp" />

            <TextView
                android:id="@+id/tv_p7"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="2dp"
                android:layout_weight="3"
                android:gravity="end|center_horizontal"
                android:text="BC :"
                android:textAppearance="@android:style/TextAppearance.Medium"
                android:textColor="#000000"
                android:textSize="10dp" />

            <TextView
                android:id="@+id/tv_blanket_cover"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="2dp"
                android:layout_weight="1.8"
                android:text="0"
                android:textAppearance="@android:style/TextAppearance.Medium"
                android:textColor="#000000"
                android:textSize="10dp" />

            <TextView
                android:id="@+id/tv_p8"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="2dp"
                android:layout_weight="3"
                android:gravity="end|center_horizontal"
                android:text="HT :"
                android:textAppearance="@android:style/TextAppearance.Medium"
                android:textColor="#000000"
                android:textSize="10dp" />

            <TextView
                android:id="@+id/tv_face_towel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="2dp"
                android:layout_weight="1.8"
                android:text="0"
                android:textAppearance="@android:style/TextAppearance.Medium"
                android:textColor="#000000"
                android:textSize="10dp" />

            <TextView
                android:id="@+id/tv_p9"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="2dp"
                android:layout_weight="2.5"
                android:gravity="end|center_horizontal"
                android:text="BLK :"
                android:textAppearance="@android:style/TextAppearance.Medium"
                android:textColor="#000000"
                android:textSize="10dp" />

            <TextView
                android:id="@+id/tv_blanket"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="2dp"
                android:layout_weight="1.8"
                android:text="0"
                android:textAppearance="@android:style/TextAppearance.Medium"
                android:textColor="#000000"
                android:textSize="10dp" />


        </LinearLayout>
    </LinearLayout>

</LinearLayout>
