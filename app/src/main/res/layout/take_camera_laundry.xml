<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".LaundryActivity.TakeCameraLaundry">
    <RelativeLayout
        android:id="@+id/rl"
        android:layout_width="match_parent"
        android:layout_height="?actionBarSize"
        android:background="@color/colorAccent"
        android:gravity="center_vertical">
        <ImageView
            android:id="@+id/v_back"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:layout_marginStart="8dp"
            android:visibility="gone"
            android:src="@drawable/back"
            app:tint="@color/colorWhite" />

        <TextView
            android:id="@+id/tv_toolbar_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:fontFamily="@font/droid_serif"
            android:gravity="center"
            android:text="Take Images &amp; Signature"
            android:textAppearance="@android:style/TextAppearance.Medium"
            android:textColor="@android:color/white"
            android:textSize="20dp"
            android:textStyle="bold" />

    </RelativeLayout>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/btn_submit"
        android:layout_below="@id/rl">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:id="@+id/camera_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_8sdp"
                android:layout_marginTop="@dimen/_4sdp"
                android:layout_marginEnd="@dimen/_8sdp"
                android:layout_marginBottom="@dimen/_8sdp"
                android:background="@drawable/bg_white"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/ll1"
                    android:layout_width="@dimen/_40sdp"
                    android:layout_height="@dimen/_80sdp"
                    android:layout_margin="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_white"
                    android:elevation="2dp"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/iv_train1"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="fitCenter"
                        android:padding="5dp"
                        android:src="@android:drawable/ic_menu_camera" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/ll2"
                    android:layout_width="@dimen/_40sdp"
                    android:layout_height="@dimen/_80sdp"
                    android:layout_margin="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_white"
                    android:elevation="2dp"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/iv_train2"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="fitCenter"
                        android:padding="5dp"
                        android:src="@android:drawable/ic_menu_camera" />
                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/camera_layout1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/camera_layout"
                android:layout_marginStart="@dimen/_8sdp"
                android:layout_marginTop="@dimen/_4sdp"
                android:layout_marginEnd="@dimen/_8sdp"
                android:layout_marginBottom="@dimen/_8sdp"
                android:background="@drawable/bg_white"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/ll3"
                    android:layout_width="@dimen/_40sdp"
                    android:layout_height="@dimen/_80sdp"
                    android:layout_margin="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_white"
                    android:elevation="2dp"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/iv_train3"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="fitCenter"
                        android:padding="5dp"
                        android:src="@android:drawable/ic_menu_camera" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/ll4"
                    android:layout_width="@dimen/_40sdp"
                    android:layout_height="@dimen/_80sdp"
                    android:layout_margin="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_white"
                    android:elevation="2dp"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/iv_train4"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="fitCenter"
                        android:padding="5dp"
                        android:src="@android:drawable/ic_menu_camera" />
                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/camera_layout2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/camera_layout1"
                android:layout_marginStart="@dimen/_8sdp"
                android:layout_marginTop="@dimen/_4sdp"
                android:layout_marginEnd="@dimen/_8sdp"
                android:layout_marginBottom="@dimen/_8sdp"
                android:background="@drawable/bg_white"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/ll5"
                    android:layout_width="@dimen/_40sdp"
                    android:layout_height="@dimen/_80sdp"
                    android:layout_margin="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_white"
                    android:elevation="2dp"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/iv_train5"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="fitCenter"
                        android:padding="5dp"
                        android:src="@android:drawable/ic_menu_camera" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/ll6"
                    android:layout_width="@dimen/_40sdp"
                    android:layout_height="@dimen/_80sdp"
                    android:layout_margin="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_white"
                    android:elevation="2dp"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/iv_train6"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="fitCenter"
                        android:padding="5dp"
                        android:src="@android:drawable/ic_menu_camera" />
                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/camera_layout3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/camera_layout2"
                android:layout_marginStart="@dimen/_8sdp"
                android:layout_marginTop="@dimen/_4sdp"
                android:layout_marginEnd="@dimen/_8sdp"
                android:layout_marginBottom="@dimen/_8sdp"
                android:background="@drawable/bg_white"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/ll7"
                    android:layout_width="@dimen/_40sdp"
                    android:layout_height="@dimen/_80sdp"
                    android:layout_margin="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_white"
                    android:elevation="2dp"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/iv_train7"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="fitCenter"
                        android:padding="5dp"
                        android:src="@android:drawable/ic_menu_camera" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/ll8"
                    android:layout_width="@dimen/_40sdp"
                    android:layout_height="@dimen/_80sdp"
                    android:layout_margin="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_white"
                    android:elevation="2dp"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/iv_train8"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="fitCenter"
                        android:padding="5dp"
                        android:src="@android:drawable/ic_menu_camera" />
                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/camera_layout4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/camera_layout3"
                android:layout_marginStart="@dimen/_8sdp"
                android:layout_marginTop="@dimen/_4sdp"
                android:layout_marginEnd="@dimen/_8sdp"
                android:layout_marginBottom="@dimen/_8sdp"
                android:background="@drawable/bg_white"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/ll9"
                    android:layout_width="@dimen/_40sdp"
                    android:layout_height="@dimen/_80sdp"
                    android:layout_margin="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_white"
                    android:elevation="2dp"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/iv_train9"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="fitCenter"
                        android:padding="5dp"
                        android:src="@android:drawable/ic_menu_camera" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/ll10"
                    android:layout_width="@dimen/_40sdp"
                    android:layout_height="@dimen/_80sdp"
                    android:layout_margin="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_white"
                    android:elevation="2dp"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/iv_train10"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="fitCenter"
                        android:padding="5dp"
                        android:src="@android:drawable/ic_menu_camera" />
                </LinearLayout>

            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/signature_layout"
                android:layout_below="@id/camera_layout4"
                android:layout_marginTop="@dimen/_1sdp"
                android:layout_margin="14dp"
                android:background="@drawable/bg_white"
                android:orientation="horizontal">

                <RelativeLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:background="@drawable/shape_outline"
                    android:layout_margin="8dp"
                    android:elevation="2dp">
                    <TextView
                        android:id="@+id/tv1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="14sp"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:textAppearance="@android:style/TextAppearance.Medium"
                        android:text="Signature of supervisor"/>
                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_marginEnd="4dp"
                        android:layout_below="@id/tv1"
                        android:layout_alignParentEnd="true"
                        android:id="@+id/click1"
                        android:layout_gravity="center_horizontal"
                        android:src="@drawable/icon_pen"/>
                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="80dp"
                        android:layout_below="@id/tv1"
                        android:layout_alignParentStart="true"
                        android:layout_toStartOf="@+id/click1"
                        android:layout_alignParentEnd="true"
                        android:id="@+id/img_sign1"
                        android:layout_gravity="center_horizontal"/>
                </RelativeLayout>

            </LinearLayout>
        </RelativeLayout>

    </ScrollView>

    <Button
        android:id="@+id/btn_submit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="10dp"
        android:layout_marginTop="1dp"
        android:layout_marginEnd="10dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/button_blue_bg"
        android:gravity="center"
        android:text="SUBMIT"
        android:textAppearance="@android:style/TextAppearance.Large"
        android:textColor="@android:color/white"
        android:textStyle="bold" />

</RelativeLayout>