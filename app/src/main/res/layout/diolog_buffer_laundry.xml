<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/colorHint"
    android:gravity="center">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_corner8"
        android:gravity="center"
        android:orientation="vertical"
        android:elevation="@dimen/_8sdp"
        android:layout_margin="@dimen/_30sdp">
        <RelativeLayout
            android:id="@+id/rl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#00BCD4"
            android:paddingVertical="@dimen/_4sdp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tv_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:gravity="center"
                android:text="Received from Laundry"
                android:textAppearance="@style/Base.TextAppearance.AppCompat.Large"
                android:textColor="@android:color/white"
                android:textSize="20sp" />

        </RelativeLayout>


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/_16sdp"
            android:layout_marginTop="@dimen/_5sdp"
            android:gravity="center_vertical"
            android:orientation="vertical"
            app:layout_constraintTop_toBottomOf="@+id/ll_uid">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Date:"
                    android:layout_weight="1"
                    android:textColor="@color/black"
                    app:tint="@color/colorWhite"/>
                <TextView
                    android:id="@+id/tv_date"
                    android:layout_width="match_parent"
                    android:gravity="center"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColorHint="@color/colorHint"
                    android:textColor="@android:color/black"
                    android:background="@drawable/shape_circle"
                    android:scrollHorizontally="false"
                    android:scrollbars="vertical" />
                />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="@dimen/_5sdp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="status:"
                    android:layout_weight="1"
                    android:textColor="@color/black"
                    app:tint="@color/colorWhite"/>
                <TextView
                    android:id="@+id/tv_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:textColorHint="@color/colorHint"
                    android:textColor="@android:color/black"
                    android:background="@drawable/shape_circle" />
                />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="@dimen/_5sdp"
                android:layout_weight="1">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Bed sheet:"
                    android:layout_weight="1"
                    android:textColor="@color/black"
                    app:tint="@color/colorWhite"/>
                <TextView
                    android:id="@+id/tv_bed_sheet"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:textColorHint="@color/colorHint"
                    android:textColor="@android:color/black"
                    android:background="@drawable/shape_circle" />
                />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_5sdp"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="pillow:"
                    android:layout_weight="1"
                    android:textColor="@color/black"
                    app:tint="@color/colorWhite"/>
                <TextView
                    android:id="@+id/tv_pillow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:textColorHint="@color/colorHint"
                    android:textColor="@android:color/black"
                    android:background="@drawable/shape_circle"
                   />
                />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="@dimen/_5sdp"
                android:layout_weight="1">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Pillow cover:"
                    android:layout_weight="1"
                    android:textColor="@color/black"
                    app:tint="@color/colorWhite"/>
                <TextView
                    android:id="@+id/tv_pillow_cover"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:textColorHint="@color/colorHint"
                    android:textColor="@android:color/black"
                    android:background="@drawable/shape_circle"
                   />
                />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="@dimen/_5sdp"
                android:layout_weight="1">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Blanket:"
                    android:layout_weight="1"
                    android:textColor="@color/black"
                    app:tint="@color/colorWhite"/>
                <TextView
                    android:id="@+id/tv_blanket"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:textColorHint="@color/colorHint"
                    android:textColor="@android:color/black"
                    android:background="@drawable/shape_circle"
                    />
                />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="@dimen/_5sdp"
                android:layout_weight="1">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Blanket cover:"
                    android:layout_weight="1"
                    android:textColor="@color/black"
                    app:tint="@color/colorWhite"/>
                <TextView
                    android:id="@+id/tv_blanket_cover"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:textColorHint="@color/colorHint"
                    android:textColor="@android:color/black"
                    android:background="@drawable/shape_circle"
                    />
                />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="@dimen/_5sdp"
                android:layout_weight="1">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Hand towel:"
                    android:layout_weight="1"
                    android:textColor="@color/black"
                    app:tint="@color/colorWhite"/>
                <TextView
                    android:id="@+id/tv_hand_towel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:textColorHint="@color/colorHint"
                    android:textColor="@android:color/black"
                    android:background="@drawable/shape_circle" />
                />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="@dimen/_5sdp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Reason:"
                    android:layout_weight="1"
                    android:textColor="@color/black"
                    app:tint="@color/colorWhite"/>
                <TextView
                    android:id="@+id/et_reason"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColorHint="@color/colorHint"
                    android:textColor="@android:color/black"
                    android:background="@drawable/shape_circle"
                    android:lines="3"
                    android:scrollHorizontally="false"
                    android:scrollbars="vertical" />
                />
            </LinearLayout>



        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_16sdp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/v_negative"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_30sdp"
                android:layout_margin="@dimen/_16sdp"
                android:background="@drawable/bg_corner8"
                android:backgroundTint="@android:color/holo_red_dark"
                android:elevation="@dimen/_2sdp"
                android:textSize="15dp"
                android:fontFamily="@font/droid_serif"
                android:gravity="center"
                android:text="Cancel"
                android:textColor="@android:color/white" />

            <TextView
                android:id="@+id/v_positive"
                android:layout_width="0dp"
                android:layout_height="@dimen/_30sdp"
                android:layout_margin="@dimen/_16sdp"
                android:background="@drawable/bg_corner8"
                android:gravity="center"
                android:visibility="gone"
                android:elevation="@dimen/_2sdp"
                android:fontFamily="@font/droid_serif"
                android:backgroundTint="@color/colorGreen"
                android:textColor="@android:color/white"
                android:text="Save"/>
        </LinearLayout>

    </LinearLayout>
</LinearLayout>