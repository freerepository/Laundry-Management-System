<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".LaundryActivity.BufferStockIssueAddDepot">
    <RelativeLayout
        android:id="@+id/rl"
        android:layout_width="match_parent"
        android:layout_height="?actionBarSize"
        android:background="@color/colorAccent"
        android:gravity="center_vertical">
        <ImageView
            android:id="@+id/v_back"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:layout_marginStart="12dp"
            android:src="@drawable/back"
            app:tint="@color/colorWhite" />


        <TextView
            android:id="@+id/tv_toolbar_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:fontFamily="@font/droid_serif"
            android:gravity="center"
            android:text="Issue new buffer stock"
            android:textAppearance="@android:style/TextAppearance.Medium"
            android:textColor="@android:color/white"
            android:textSize="20dp"
            android:textStyle="bold" />

    </RelativeLayout>

    <LinearLayout
        android:id="@+id/linearLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/rl"
        android:layout_marginStart="6dp"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="6dp"
        android:layout_marginBottom="6dp"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/supOfficer_layout"
            style="@style/border"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="horizontal">

            <View
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:layout_marginStart="5dp"
                android:background="@drawable/calendar_icon"
                android:backgroundTint="@color/colorAccent" />

            <EditText
                android:id="@+id/et_date"
                android:layout_width="match_parent"
                android:layout_height="30sp"
                android:layout_centerVertical="true"
                android:layout_marginStart="@dimen/_6sdp"
                android:background="@null"
                android:backgroundTint="@color/hint_color"
                android:clickable="false"
                android:cursorVisible="false"
                android:focusable="false"
                android:focusableInTouchMode="false"
                android:fontFamily="sans-serif"
                android:hint="Select Date"
                android:maxLines="1"
                style="@style/text"
                android:textSize="15dp" />


        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="@dimen/_12sdp"
            android:layout_weight="1"
            style="@style/border"
            android:gravity="center"
            android:orientation="horizontal">

            <Spinner
                android:id="@+id/sp_depot"
                android:layout_width="match_parent"
                android:layout_height="30sp"
                android:layout_centerVertical="true"
                android:layout_marginStart="@dimen/_6sdp"
                android:backgroundTint="@color/hint_color"
                android:clickable="false"
                android:cursorVisible="false"
                android:focusable="false"
                android:focusableInTouchMode="false"
                android:fontFamily="sans-serif"
                android:maxLines="1"
                style="@style/text"
                android:textSize="15dp" />


        </LinearLayout>


    </LinearLayout>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_below="@+id/linearLayout"
        android:layout_above="@+id/signature_layout"
        android:layout_marginBottom="2dp"
        android:layout_margin="4dp"
        android:id="@+id/cardview"
        android:layout_height="wrap_content">

        <LinearLayout
            android:id="@+id/title_layout"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:paddingTop="4dp"
            android:visibility="gone"
            android:paddingBottom="4dp"
            android:orientation="horizontal"
            android:background="@color/colorAccent">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:textSize="12dp"
                android:layout_marginTop="6dp"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:layout_marginLeft="5dp"
                android:textAppearance="@android:style/TextAppearance.Medium"
                android:text="SNo."/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12dp"
                android:paddingLeft="10dp"
                android:layout_weight="3"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:textColor="@android:color/white"
                android:textStyle="bold"
                android:textAppearance="@android:style/TextAppearance.Medium"
                android:text="Item Name"/>


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12dp"
                android:gravity="center"
                android:layout_weight="2"
                android:layout_marginTop="6dp"
                android:textColor="@android:color/white"
                android:textStyle="bold"
                android:textAppearance="@android:style/TextAppearance.Medium"
                android:text="Qty"/>

        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="4dp"
                android:orientation="vertical">
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="@dimen/_12sdp"
                    app:cardElevation="@dimen/_2sdp"
                    app:cardCornerRadius="@dimen/_5sdp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@color/background">

                        <TextView
                            android:id="@+id/tv_index1"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:gravity="center_vertical"
                            android:layout_weight="1"
                            android:textSize="13dp"
                            android:layout_margin="4dp"
                            android:textAppearance="@android:style/TextAppearance.Medium"
                            android:textColor="@android:color/black"
                            android:text="1"/>
                        <TextView
                            android:id="@+id/tv_qus1"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="5"
                            android:textSize="13dp"
                            android:paddingLeft="5dp"
                            android:layout_gravity="center"
                            android:paddingRight="5dp"
                            android:gravity="center_vertical"
                            android:textAppearance="@android:style/TextAppearance.Medium"
                            android:textColor="@android:color/black"
                            android:text="Bed sheet"/>


                        <EditText
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="2"
                            android:hint="0"
                            android:layout_margin="2dp"
                            android:gravity="center"
                            android:textSize="13sp"
                            android:maxLength="13"
                            android:id="@+id/et_bed_sheet"
                            android:background="@drawable/shape_outline"
                            android:autofillHints=""
                            android:inputType="number"
                            tools:ignore="TextFields" />


                    </LinearLayout>

                </androidx.cardview.widget.CardView>
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="@dimen/_12sdp"
                    app:cardElevation="@dimen/_2sdp"
                    app:cardCornerRadius="@dimen/_5sdp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@color/background">

                        <TextView
                            android:id="@+id/tv_index2"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:gravity="center_vertical"
                            android:layout_weight="1"
                            android:textSize="13dp"
                            android:layout_margin="4dp"
                            android:textAppearance="@android:style/TextAppearance.Medium"
                            android:textColor="@android:color/black"
                            android:text="2"/>
                        <TextView
                            android:id="@+id/tv_qus2"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="5"
                            android:textSize="13dp"
                            android:paddingLeft="5dp"
                            android:paddingRight="5dp"
                            android:layout_gravity="center"
                            android:gravity="center_vertical"
                            android:textAppearance="@android:style/TextAppearance.Medium"
                            android:textColor="@android:color/black"
                            android:text="Pillow"/>


                        <EditText
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="2"
                            android:hint="0"
                            android:layout_margin="2dp"
                            android:gravity="center"
                            android:textSize="13sp"
                            android:maxLength="13"
                            android:id="@+id/et_pillow"
                            android:background="@drawable/shape_outline"
                            android:autofillHints=""
                            android:inputType="number"
                            tools:ignore="TextFields" />


                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="@dimen/_12sdp"
                    app:cardElevation="@dimen/_2sdp"
                    app:cardCornerRadius="@dimen/_5sdp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@color/background">

                        <TextView
                            android:id="@+id/tv_index3"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:gravity="center_vertical"
                            android:layout_weight="1"
                            android:textSize="13dp"
                            android:layout_margin="4dp"
                            android:textAppearance="@android:style/TextAppearance.Medium"
                            android:textColor="@android:color/black"
                            android:text="3"/>
                        <TextView
                            android:id="@+id/tv_qus3"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="5"
                            android:textSize="13dp"
                            android:paddingLeft="5dp"
                            android:layout_gravity="center"
                            android:paddingRight="5dp"
                            android:gravity="center_vertical"
                            android:textAppearance="@android:style/TextAppearance.Medium"
                            android:textColor="@android:color/black"
                            android:text="Pillow Cover"/>


                        <EditText
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="2"
                            android:hint="0"
                            android:layout_margin="2dp"
                            android:gravity="center"
                            android:textSize="13sp"
                            android:maxLength="13"
                            android:id="@+id/et_pillow_cover"
                            android:background="@drawable/shape_outline"
                            android:autofillHints=""
                            android:inputType="number"
                            tools:ignore="TextFields" />


                    </LinearLayout>
                </androidx.cardview.widget.CardView>
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="@dimen/_12sdp"
                    app:cardElevation="@dimen/_2sdp"
                    app:cardCornerRadius="@dimen/_5sdp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@color/background">

                        <TextView
                            android:id="@+id/tv_index4"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:gravity="center_vertical"
                            android:layout_weight="1"
                            android:textSize="13dp"
                            android:layout_margin="4dp"
                            android:textAppearance="@android:style/TextAppearance.Medium"
                            android:textColor="@android:color/black"
                            android:text="4"/>
                        <TextView
                            android:id="@+id/tv_qus4"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="5"
                            android:textSize="13dp"
                            android:paddingLeft="5dp"
                            android:layout_gravity="center"
                            android:paddingRight="5dp"
                            android:gravity="center_vertical"
                            android:textAppearance="@android:style/TextAppearance.Medium"
                            android:textColor="@android:color/black"
                            android:text="Blanket"/>


                        <EditText
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="2"
                            android:hint="0"
                            android:layout_margin="2dp"
                            android:gravity="center"
                            android:textSize="13sp"
                            android:maxLength="13"
                            android:id="@+id/et_blanket"
                            android:background="@drawable/shape_outline"
                            android:autofillHints=""
                            android:inputType="number"
                            tools:ignore="TextFields" />


                    </LinearLayout>
                </androidx.cardview.widget.CardView>
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="@dimen/_12sdp"
                    app:cardElevation="@dimen/_2sdp"
                    app:cardCornerRadius="@dimen/_5sdp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@color/background">

                        <TextView
                            android:id="@+id/tv_index5"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:gravity="center_vertical"
                            android:layout_weight="1"
                            android:textSize="13dp"
                            android:layout_margin="4dp"
                            android:textAppearance="@android:style/TextAppearance.Medium"
                            android:textColor="@android:color/black"
                            android:text="5"/>
                        <TextView
                            android:id="@+id/tv_qus5"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="5"
                            android:textSize="13dp"
                            android:paddingLeft="5dp"
                            android:layout_gravity="center"
                            android:paddingRight="5dp"
                            android:gravity="center_vertical"
                            android:textAppearance="@android:style/TextAppearance.Medium"
                            android:textColor="@android:color/black"
                            android:text="Blanket Cover"/>


                        <EditText
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="2"
                            android:hint="0"
                            android:layout_margin="2dp"
                            android:gravity="center"
                            android:textSize="13sp"
                            android:maxLength="13"
                            android:id="@+id/et_blanket_cover"
                            android:background="@drawable/shape_outline"
                            android:autofillHints=""
                            android:inputType="number"
                            tools:ignore="TextFields" />


                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="@dimen/_12sdp"
                    app:cardElevation="@dimen/_2sdp"
                    app:cardCornerRadius="@dimen/_5sdp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@color/background">

                        <TextView
                            android:id="@+id/tv_index6"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:gravity="center_vertical"
                            android:layout_weight="1"
                            android:textSize="13dp"
                            android:layout_margin="4dp"
                            android:textAppearance="@android:style/TextAppearance.Medium"
                            android:textColor="@android:color/black"
                            android:text="6"/>
                        <TextView
                            android:id="@+id/tv_qus6"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="5"
                            android:textSize="13dp"
                            android:paddingLeft="5dp"
                            android:layout_gravity="center"
                            android:paddingRight="5dp"
                            android:gravity="center_vertical"
                            android:textAppearance="@android:style/TextAppearance.Medium"
                            android:textColor="@android:color/black"
                            android:text="Hand Towel"/>


                        <EditText
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="2"
                            android:hint="0"
                            android:layout_margin="2dp"
                            android:gravity="center"
                            android:textSize="13sp"
                            android:maxLength="13"
                            android:id="@+id/et_hand_towel"
                            android:background="@drawable/shape_outline"
                            android:autofillHints=""
                            android:inputType="number"
                            tools:ignore="TextFields" />


                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="80dp"
                    android:layout_marginTop="@dimen/_12sdp"
                    app:cardElevation="@dimen/_2sdp"
                    app:cardCornerRadius="@dimen/_5sdp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="80dp"
                        android:orientation="vertical"
                        android:background="@color/background" >

                        <TextView
                            android:id="@+id/tv_qus7"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="13dp"
                            android:paddingLeft="5dp"
                            android:paddingRight="5dp"
                            android:gravity="center_vertical"
                            android:textAppearance="@android:style/TextAppearance.Medium"
                            android:textColor="@android:color/black"
                            android:text="Reason"/>


                        <EditText
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:layout_margin="2dp"
                            android:textSize="13sp"
                            android:lines="20"
                            android:scrollbars="vertical"
                            android:scrollHorizontally="false"
                            android:gravity="top|left"
                            android:hint="Start Typing..."
                            android:maxLength="100"
                            android:inputType="textMultiLine"
                            android:id="@+id/et_reason"
                            android:background="@drawable/shape_outline"
                            android:autofillHints=""
                            tools:ignore="TextFields" />


                    </LinearLayout>
                </androidx.cardview.widget.CardView>



            </LinearLayout>

        </ScrollView>

    </RelativeLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:id="@+id/signature_layout"
        android:layout_margin="5dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/rl"
            android:layout_marginTop="4dp"
            android:layout_margin="4dp"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/remark"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/shape"
                android:gravity="center"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_next_submit"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:textColor="@android:color/white"
                    android:textStyle="bold"
                    android:textAppearance="@android:style/TextAppearance.Large"
                    android:text="Submit"
                    android:background="@drawable/et_white_bg"/>
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>
</RelativeLayout>