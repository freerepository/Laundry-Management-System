<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    tools:context=".Activity.SecondFragment">
    <RelativeLayout
        android:id="@+id/rl"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:gravity="center_vertical"
        android:background="@color/colorBackground">

        <TextView
            android:id="@+id/addImg_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:layout_marginRight="10dp"
            android:gravity="center"
            android:text="Clean Bedroll Laundry Supply Summary\n to Depot"
            android:textColor="@color/black"
            android:fontFamily="@font/droid_serif"
            android:textSize="13sp"
            android:textStyle="bold" />




    </RelativeLayout>
    <LinearLayout
        android:id="@+id/linearLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/rl"
        android:layout_marginTop="4dp"
        android:layout_margin="4dp"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/supOfficer_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            style="@style/border"
            android:layout_marginRight="5dp"
            android:gravity="center"
            android:orientation="horizontal">
            <ImageView
                android:id="@+id/ic_calenderfrom_"
                android:layout_width="30sp"
                android:layout_height="30sp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:layout_marginStart="10dp"
                app:tint="@color/colorAccent"
                android:src="@drawable/icon_calendar"
                android:padding="4dp"/>
            <EditText
                android:id="@+id/et_datefrom_"
                android:layout_width="match_parent"
                android:layout_height="30sp"
                android:layout_centerVertical="true"
                android:background="@null"
                android:backgroundTint="@color/hint_color"
                android:clickable="false"
                android:cursorVisible="false"
                style="@style/text"
                android:focusable="false"
                android:layout_marginStart="@dimen/_6sdp"
                android:focusableInTouchMode="false"
                android:fontFamily="sans-serif"
                android:hint="From Date"
                android:maxLines="1"
                android:textSize="15dp" />


        </LinearLayout>
        <LinearLayout
            android:id="@+id/train_no_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            style="@style/border"
            android:gravity="center"
            android:orientation="horizontal">
            <ImageView
                android:id="@+id/ic_calenderto_"
                android:layout_width="30sp"
                android:layout_height="30sp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:layout_marginStart="10dp"
                app:tint="@color/colorAccent"
                android:src="@drawable/icon_calendar"
                android:padding="4dp"/>

            <EditText
                android:id="@+id/et_dateto_"
                android:layout_width="match_parent"
                android:layout_height="30sp"
                android:layout_centerVertical="true"
                android:background="@null"
                android:backgroundTint="@color/hint_color"
                android:clickable="false"
                android:cursorVisible="false"
                style="@style/text"
                android:focusable="false"
                android:layout_marginStart="@dimen/_6sdp"
                android:focusableInTouchMode="false"
                android:fontFamily="sans-serif"
                android:hint="To Date"
                android:maxLines="1"
                android:textSize="15dp" />

        </LinearLayout>

    </LinearLayout>
    <LinearLayout
        android:id="@+id/linearLayout1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/linearLayout"
        android:layout_marginTop="4dp"
        android:layout_margin="4dp"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/laundry_layout"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            style="@style/border"
            android:gravity="center"

            android:orientation="horizontal">

            <Spinner
                android:id="@+id/sp_depot"
                android:layout_width="match_parent"
                android:layout_height="35dp"
                android:layout_weight="0.4"
                android:layout_marginStart="10dp"
                android:textColor="@color/black"
                android:spinnerMode="dropdown"
                />

<!--            <Button-->
<!--                android:id="@+id/filterButton"-->
<!--                android:layout_width="match_parent"-->
<!--                android:layout_height="45dp"-->
<!--                android:layout_weight="0.6"-->
<!--                android:text="Filter Data"-->
<!--                android:textColor="@color/background"-->
<!--                tools:ignore="ObsoleteLayoutParam" />-->


        </LinearLayout>


    </LinearLayout>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_below="@+id/linearLayout1"
        android:layout_above="@+id/signature_layout"
        android:layout_marginBottom="2dp"
        android:layout_margin="4dp"
        android:id="@+id/cardview"
        android:layout_height="wrap_content">

        <LinearLayout
            android:id="@+id/title_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:orientation="horizontal"
            android:background="@color/colorBG">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:textSize="12dp"
                android:layout_marginTop="6dp"
                android:textColor="@android:color/black"
                android:textStyle="bold"
                android:layout_marginLeft="5dp"
                android:textAppearance="@android:style/TextAppearance.Medium"
                android:text="SNo."/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12dp"
                android:paddingLeft="10dp"
                android:layout_weight="2"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:textColor="@android:color/black"
                android:textStyle="bold"
                android:textAppearance="@android:style/TextAppearance.Medium"
                android:text="Train No"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:layout_weight="2.1"
                android:text="Date"
                android:layout_marginTop="6dp"
                android:textAppearance="@android:style/TextAppearance.Medium"
                android:textColor="@android:color/black"
                android:textSize="13dp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12dp"
                android:gravity="center"
                android:layout_weight="2"
                android:layout_marginTop="6dp"
                android:textColor="@android:color/black"
                android:textStyle="bold"
                android:textAppearance="@android:style/TextAppearance.Medium"
                android:text="Bed\nsheet"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="3"
                android:textSize="12dp"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:textColor="@android:color/black"
                android:textStyle="bold"
                android:textAppearance="@android:style/TextAppearance.Medium"
                android:text="Pillow\nCover"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="3"
                android:textSize="12dp"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:textColor="@android:color/black"
                android:textStyle="bold"
                android:textAppearance="@android:style/TextAppearance.Medium"
                android:text="Hand\nTowel"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="3"
                android:textSize="12dp"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:textColor="@android:color/black"
                android:textStyle="bold"
                android:textAppearance="@android:style/TextAppearance.Medium"
                android:text="Blanket"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="3"
                android:textSize="12dp"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:textColor="@android:color/black"
                android:textStyle="bold"
                android:textAppearance="@android:style/TextAppearance.Medium"
                android:text="Blanket\nCover"/>
        </LinearLayout>

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/srl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/title_layout"
            android:layout_marginTop="8dp">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerView"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
        <TextView
            android:id="@+id/tv_empty_data"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="Data not found"
            android:textColor="@color/colorHint"
            android:textSize="15dp" />
    </RelativeLayout>



    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@id/bottom_layout"
        android:id="@+id/signature_layout"
        android:layout_margin="5dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/rl"
            android:layout_marginTop="4dp"
            android:layout_margin="4dp"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/remark"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                style="@style/border"
                android:layout_marginRight="5dp"
                android:gravity="center"
                android:orientation="horizontal">

                <Spinner
                    android:id="@+id/sp_remark"
                    android:layout_width="match_parent"
                    android:layout_height="30dp"
                    android:spinnerMode="dropdown"
                    />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/amount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                style="@style/border"
                android:gravity="center"
                android:orientation="horizontal">


                <EditText
                    android:layout_width="match_parent"
                    android:layout_height="30dp"
                    android:hint="Amount"
                    android:gravity="center"
                    android:textSize="13sp"
                    android:maxLength="10"
                    android:id="@+id/et_Pamount"
                    android:autofillHints=""
                    android:background="@null"
                    android:inputType="number"
                    tools:ignore="TextFields" />
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>
    <LinearLayout
        android:id="@+id/bottom_layout"
        android:layout_alignParentBottom="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/colorBlueDark">

        <TextView
            android:id="@+id/tv_total_penality_amount"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:visibility="gone"
            android:textColor="@android:color/white"
            android:textStyle="bold"
            android:text="Total:"
            android:textAppearance="@android:style/TextAppearance.Large"/>

        <Button
            android:id="@+id/btn_next_submit"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:textColor="@android:color/white"
            android:textStyle="bold"
            android:textAppearance="@android:style/TextAppearance.Large"
            android:text="NEXT"
            android:background="@color/darkTextColor"/>
    </LinearLayout>

</LinearLayout>