<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="4dp"
    android:paddingBottom="4dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:background="@drawable/btn1"
    android:layout_margin="1dp"
    android:elevation="@dimen/_4sdp"
    android:minHeight="50dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1">

            <TextView
                    android:id="@+id/tv_index"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:textSize="12dp"
                    android:layout_weight="1"
                    android:gravity="center"
                android:layout_gravity="center"
                    android:textColor="#000000"
                    android:layout_margin="2dp"
                    android:textAppearance="@android:style/TextAppearance.Medium"
                    android:text="1"/>
            <TextView
                android:id="@+id/tv_date"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textSize="12dp"
                android:layout_weight="3"
                android:gravity="center"
                android:layout_gravity="center"
                android:textColor="#000000"
                android:layout_margin="2dp"
                android:textAppearance="@android:style/TextAppearance.Medium"
                android:text="date"/>
                <TextView
                    android:id="@+id/tv_store_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:textSize="12dp"
                    android:layout_weight="2"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:textColor="#000000"
                    android:layout_margin="2dp"
                    android:textAppearance="@android:style/TextAppearance.Medium"
                    android:text="Depot Name "/>

            <TextView
                    android:id="@+id/tv_train_n"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:textSize="12dp"
                    android:layout_weight="3"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:textColor="#000000"
                    android:layout_margin="2dp"
                    android:textAppearance="@android:style/TextAppearance.Medium"
                    android:text="Depot Name "/>



                <TextView
                    android:id="@+id/tv_status_verify"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:textSize="10dp"
                    android:layout_weight="2"
                    android:textColor="#000000"
                    android:layout_margin="2dp"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:textAppearance="@android:style/TextAppearance.Medium"
                    android:text="Updated"/>


                <ImageView
                    android:id="@+id/iv_ivew_status"
                    android:layout_width="0dp"
                    android:layout_height="32dp"
                    android:textSize="1dp"
                    android:layout_weight="2"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:textColor="#000000"
                    android:layout_margin="3dp"
                    android:paddingRight="5dp"
                    android:src="@drawable/icon_view"
                    android:textAppearance="@android:style/TextAppearance.Medium"
                    android:text=""/>

            <TextView
                    android:id="@+id/iv_ivew_status_verify"
                    android:layout_width="0dp"
                    android:layout_height="30dp"
                    android:textSize="10dp"
                    android:layout_weight="2"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:textColor="#000000"
                    android:layout_margin="3dp"
                    android:paddingRight="5dp"
                    android:src="@drawable/clean_icon3"
                    android:textAppearance="@android:style/TextAppearance.Medium"
                    android:text="Cleaned"/>
<!--            <ImageView-->
<!--                    android:id="@+id/iv_ivew_status_verify"-->
<!--                    android:layout_width="0dp"-->
<!--                    android:layout_height="30dp"-->
<!--                    android:textSize="1dp"-->
<!--                    android:layout_weight="2"-->
<!--                    android:gravity="center"-->
<!--                    android:layout_gravity="center"-->
<!--                    android:textColor="#000000"-->
<!--                    android:layout_margin="3dp"-->
<!--                    android:paddingRight="5dp"-->
<!--                    android:src="@drawable/clean_icon3"-->
<!--                    android:textAppearance="@android:style/TextAppearance.Medium"-->
<!--                    android:text=""/>-->





        </LinearLayout>


    </LinearLayout>


</LinearLayout>
