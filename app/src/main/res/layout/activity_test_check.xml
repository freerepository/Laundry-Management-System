<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".DeportActivity.TestCheckActivity">
    <RelativeLayout
        android:id="@+id/rl"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:gravity="center_vertical"
        android:background="@color/colorAccent">
        <ImageView
            android:id="@+id/iv_backView"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:layout_marginStart="4dp"
            app:tint="@android:color/white"
            android:src="@drawable/back"
            android:padding="4dp"/>

        <TextView
            android:id="@+id/addImg_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:layout_marginRight="10dp"
            android:gravity="center"
            android:text="Test Check for Depot"
            android:textColor="@android:color/white"
            android:fontFamily="@font/droid_serif"
            android:textSize="20sp"
            android:textStyle="bold" />




    </RelativeLayout>
    <LinearLayout
        android:id="@+id/linearLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/rl"
        android:layout_marginTop="4dp"
        android:layout_margin="4dp"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/supOfficer_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/shape"
            android:layout_marginRight="5dp"
            android:gravity="center"
            android:orientation="horizontal">

            <Spinner
                android:id="@+id/sp_officer_supervisor"
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:spinnerMode="dropdown"
                />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/train_no_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/shape"
            android:gravity="center"
            android:orientation="horizontal">

            <Spinner
                android:id="@+id/sp_train_no"
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:spinnerMode="dropdown"
                />
        </LinearLayout>

    </LinearLayout>
    <LinearLayout
        android:id="@+id/linearLayout1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/linearLayout"
        android:layout_marginTop="4dp"
        android:layout_margin="4dp"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/laundry_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/shape"
            android:gravity="center"
            android:orientation="horizontal">

            <Spinner
                android:id="@+id/sp_laundry_name"
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:spinnerMode="dropdown"
                />
        </LinearLayout>


    </LinearLayout>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_below="@+id/linearLayout1"
        android:layout_above="@+id/signature_layout"
        android:layout_marginBottom="2dp"
        android:layout_margin="4dp"
        android:id="@+id/cardview"
        android:layout_height="wrap_content">

        <LinearLayout
            android:id="@+id/title_layout"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:orientation="horizontal"
            android:background="@color/background">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:textSize="12dp"
                android:layout_marginTop="6dp"
                android:textColor="@android:color/black"
                android:textStyle="bold"
                android:layout_marginLeft="5dp"
                android:textAppearance="@android:style/TextAppearance.Medium"
                android:text="SNo."/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12dp"
                android:paddingLeft="10dp"
                android:layout_weight="5"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:textColor="@android:color/black"
                android:textStyle="bold"
                android:textAppearance="@android:style/TextAppearance.Medium"
                android:text="Item Name"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:layout_weight="2.1"
                android:text="Item No."
                android:layout_marginTop="6dp"
                android:textAppearance="@android:style/TextAppearance.Medium"
                android:textColor="@android:color/black"
                android:textSize="13dp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12dp"
                android:gravity="center"
                android:layout_weight="2"
                android:layout_marginTop="6dp"
                android:textColor="@android:color/black"
                android:textStyle="bold"
                android:textAppearance="@android:style/TextAppearance.Medium"
                android:text="WMI"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="3"
                android:textSize="12dp"
                android:gravity="center"
                android:visibility="gone"
                android:textColor="@android:color/black"
                android:textStyle="bold"
                android:textAppearance="@android:style/TextAppearance.Medium"
                android:text="Penalty"/>
        </LinearLayout>

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/srl"
            android:layout_marginTop="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/title_layout">
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerView"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
    </RelativeLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@id/bottom_layout"
        android:id="@+id/signature_layout"
        android:layout_margin="5dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/rl"
            android:layout_marginTop="4dp"
            android:layout_margin="4dp"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/remark"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/shape"
                android:layout_marginRight="5dp"
                android:gravity="center"
                android:orientation="horizontal">

                <Spinner
                    android:id="@+id/sp_remark"
                    android:layout_width="match_parent"
                    android:layout_height="30dp"
                    android:spinnerMode="dropdown"
                    />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/amount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/shape"
                android:gravity="center"
                android:orientation="horizontal">


                <EditText
                    android:layout_width="match_parent"
                    android:layout_height="30dp"
                    android:hint="Amount"
                    android:gravity="center"
                    android:textSize="13sp"
                    android:maxLength="10"
                    android:id="@+id/et_Pamount"
                    android:autofillHints=""
                    android:background="@null"
                    android:inputType="number"
                    tools:ignore="TextFields" />
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>
    <LinearLayout
        android:id="@+id/bottom_layout"
        android:layout_alignParentBottom="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/colorBlueDark">

        <TextView
            android:id="@+id/tv_total_penality_amount"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:visibility="gone"
            android:textColor="@android:color/white"
            android:textStyle="bold"
            android:text="Total:"
            android:textAppearance="@android:style/TextAppearance.Large"/>

        <Button
            android:id="@+id/btn_next_submit"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:textColor="@android:color/white"
            android:textStyle="bold"
            android:textAppearance="@android:style/TextAppearance.Large"
            android:text="NEXT"
            android:background="@color/darkTextColor"/>
    </LinearLayout>
</RelativeLayout>