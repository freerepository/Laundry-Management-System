<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="2dp"
    android:background="@color/colorBackground"
    android:elevation="@dimen/_4sdp"
    android:gravity="center_vertical"
    android:minHeight="48dp"
    android:orientation="horizontal"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1">

            <TextView
                android:id="@+id/tv_index"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_weight="1"
                android:gravity="center"
                android:text="1"
                android:textAppearance="@android:style/TextAppearance.Medium"
                android:textColor="@android:color/black"
                android:textSize="12dp" />

            <TextView
                android:id="@+id/tv_date"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_margin="2dp"
                android:layout_weight="3"
                android:gravity="center"
                android:text="date"
                android:textAppearance="@android:style/TextAppearance.Medium"
                android:textColor="#000000"
                android:textSize="12dp" />

            <TextView
                android:id="@+id/tv_depot"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_margin="2dp"
                android:layout_weight="2"
                android:text="KYQ"
                android:textAppearance="@android:style/TextAppearance.Medium"
                android:textColor="#000000"
                android:textSize="12dp" />

            <TextView
                android:id="@+id/tv_train"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_margin="2dp"
                android:layout_weight="2"
                android:text="12345"
                android:textAppearance="@android:style/TextAppearance.Medium"
                android:textColor="#000000"
                android:textSize="10dp" />

            <TextView
                android:id="@+id/tv_coach"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_margin="2dp"
                android:layout_weight="2"
                android:text="Coach"
                android:textAppearance="@android:style/TextAppearance.Medium"
                android:textColor="#000000"
                android:textSize="10dp" />

            <TextView
                android:id="@+id/tv_packet"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_margin="2dp"
                android:layout_weight="3"
                android:gravity="center"
                android:text="Packets"
                android:textAppearance="@android:style/TextAppearance.Medium"
                android:textColor="#000000"
                android:textSize="12dp" />

            <ImageView
                android:id="@+id/iv_editRow"
                android:layout_width="0dp"
                android:layout_height="22dp"
                android:layout_margin="3dp"
                android:layout_weight="1.5"
                android:gravity="center"
                android:src="@drawable/ic_baseline_edit_24"
                android:textAppearance="@android:style/TextAppearance.Medium"
                android:textColor="#000000" />

            <ImageView
                android:id="@+id/iv_qr_scan"
                android:layout_width="0dp"
                android:layout_height="22dp"
                android:layout_margin="3dp"
                android:layout_weight="1.5"
                android:gravity="center"
                android:src="@drawable/qr_code_scan"
                android:textAppearance="@android:style/TextAppearance.Medium"
                android:textColor="#000000" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@color/colorBackground"
            android:visibility="gone">

            <TextView
                android:id="@+id/tv_b1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="2dp"
                android:layout_weight="3"
                android:gravity="end|center_horizontal"
                android:text="Train No. :"
                android:textAppearance="@android:style/TextAppearance.Medium"
                android:textColor="#000000"
                android:textSize="10dp" />

            <TextView
                android:id="@+id/tv_b2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="2dp"
                android:layout_weight="3"
                android:gravity="end|center_horizontal"
                android:text="Coach :"
                android:textAppearance="@android:style/TextAppearance.Medium"
                android:textColor="#000000"
                android:textSize="10dp" />


        </LinearLayout>

    </LinearLayout>

</LinearLayout>
