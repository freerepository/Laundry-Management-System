<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="1dp"
    android:elevation="@dimen/_4sdp"
    android:gravity="center_vertical"
    android:minHeight="48dp"
    android:orientation="horizontal"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:id="@+id/rv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/_16sdp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txt1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginVertical="@dimen/_8sdp"
                        android:hint="@color/colorWhite"
                        android:text="Date"
                        android:textColor="@color/black"
                        android:textSize="20sp" />

                    <EditText
                        android:id="@+id/tv_date"
                        android:layout_width="match_parent"
                        android:layout_height="35sp"
                        android:layout_centerVertical="true"
                        android:layout_marginRight="12dp"
                        android:background="@drawable/shape"
                        android:gravity="center"
                        android:hint="date"
                        android:inputType="number"
                        android:textColor="@android:color/black"
                        android:textColorHint="@color/colorHint"
                        android:textSize="20sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layout2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/layout3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="2dp"
                        android:orientation="horizontal">


                        <TextView
                            android:id="@+id/txt2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginVertical="@dimen/_8sdp"
                            android:text="Depot Name"
                            android:textColor="@color/black"
                            android:textSize="20sp"
                            app:tint="@color/colorWhite" />
                    </LinearLayout>


                    <EditText
                        android:id="@+id/tv_depot"
                        android:layout_width="match_parent"
                        android:layout_height="35sp"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="2dp"
                        android:background="@drawable/shape"
                        android:gravity="center"
                        android:hint="deport"
                        android:inputType="number"
                        android:textColor="@android:color/black"
                        android:textColorHint="@color/colorHint"
                        android:textSize="20sp" />
                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/_16sdp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                app:layout_constraintTop_toBottomOf="@+id/ll_uid">

                <LinearLayout
                    android:id="@+id/layout5"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/layout6"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">


                        <TextView
                            android:id="@+id/txt3"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginVertical="@dimen/_8sdp"
                            android:text="Train No."
                            android:textColor="@color/black"
                            android:textSize="20sp"
                            app:tint="@color/colorWhite" />
                    </LinearLayout>


                    <EditText
                        android:id="@+id/tv_train"
                        android:layout_width="match_parent"
                        android:layout_height="35sp"
                        android:layout_centerVertical="true"
                        android:layout_marginRight="12dp"
                        android:background="@drawable/shape"
                        android:gravity="center"
                        android:hint="train"
                        android:inputType="number"
                        android:textColor="@android:color/black"
                        android:textColorHint="@color/colorHint"
                        android:textSize="20sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="2dp"
                        android:orientation="horizontal">


                        <TextView  android:id="@+id/txt4"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginVertical="@dimen/_8sdp"
                            android:text="Coach"
                            android:textColor="@color/black"
                            android:textSize="20sp"
                            app:tint="@color/colorWhite" />
                    </LinearLayout>


                    <EditText
                        android:id="@+id/tv_coach"
                        android:layout_width="match_parent"
                        android:layout_height="35sp"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="2dp"
                        android:background="@drawable/shape"
                        android:gravity="center"
                        android:hint="coach"
                        android:inputType="number"
                        android:textColor="@android:color/black"
                        android:textColorHint="@color/colorHint"
                        android:textSize="20sp" />
                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/_16sdp"
                android:layout_marginTop="@dimen/_1sdp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                app:layout_constraintTop_toBottomOf="@+id/ll_uid">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView android:id="@+id/txt5"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginVertical="@dimen/_8sdp"
                        android:text="Bed Seat"
                        android:textColor="@color/black"
                        android:textSize="20sp"
                        app:tint="@color/colorWhite" />

                    <EditText
                        android:id="@+id/tv_bed_sheet"
                        android:layout_width="match_parent"
                        android:layout_height="35sp"
                        android:layout_centerVertical="true"
                        android:layout_marginRight="12dp"
                        android:background="@drawable/shape"
                        android:gravity="center"
                        android:hint="bed seat"
                        android:inputType="number"
                        android:textColor="@android:color/black"
                        android:textColorHint="@color/colorHint"
                        android:textSize="20sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView android:id="@+id/txt6"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginVertical="@dimen/_8sdp"
                        android:text="Blankets"
                        android:textColor="@color/black"
                        android:textSize="20sp"
                        app:tint="@color/colorWhite" />

                    <EditText
                        android:id="@+id/et_blanket"
                        android:layout_width="match_parent"
                        android:layout_height="35sp"
                        android:layout_centerVertical="true"
                        android:background="@drawable/shape"
                        android:gravity="center"
                        android:hint="blanket"
                        android:inputType="number"
                        android:textColor="@android:color/black"
                        android:textColorHint="@color/colorHint"
                        android:textSize="20sp" />
                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/_16sdp"
                android:layout_marginTop="@dimen/_2sdp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                app:layout_constraintTop_toBottomOf="@+id/ll_uid">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView android:id="@+id/txt7"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginVertical="@dimen/_8sdp"
                        android:text="Pillow Cover"
                        android:textColor="@color/black"
                        android:textSize="20sp"
                        app:tint="@color/colorWhite" />

                    <EditText
                        android:id="@+id/tv_pillow_cover"
                        android:layout_width="match_parent"
                        android:layout_height="35sp"
                        android:layout_centerVertical="true"
                        android:layout_marginRight="12dp"
                        android:background="@drawable/shape"
                        android:gravity="center"
                        android:hint="pillow cover"
                        android:inputType="number"
                        android:textColor="@android:color/black"
                        android:textColorHint="@color/colorHint"
                        android:textSize="20sp" />
                </LinearLayout>


                <LinearLayout
                    android:id="@+id/layout1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/layout"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">


                        <TextView android:id="@+id/txt8"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginVertical="@dimen/_8sdp"
                            android:text="Bath Towel"
                            android:textColor="@color/black"
                            android:textSize="20sp"
                            app:tint="@color/colorWhite" />
                    </LinearLayout>


                    <EditText
                        android:id="@+id/tv_bath_towel"
                        android:layout_width="match_parent"
                        android:layout_height="35sp"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="2dp"
                        android:background="@drawable/shape"
                        android:gravity="center"
                        android:hint="bath towel"
                        android:inputType="number"
                        android:textColor="@android:color/black"
                        android:textColorHint="@color/colorHint"
                        android:textSize="20sp" />
                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/_16sdp"
                android:layout_marginTop="@dimen/_2sdp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                app:layout_constraintTop_toBottomOf="@+id/ll_uid">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView android:id="@+id/txt9"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginVertical="@dimen/_8sdp"
                        android:text="Blanket Cover"
                        android:textColor="@color/black"
                        android:textSize="20sp"
                        app:tint="@color/colorWhite" />

                    <EditText
                        android:id="@+id/tv_blanket_cover"
                        android:layout_width="match_parent"
                        android:layout_height="35sp"
                        android:layout_centerVertical="true"
                        android:layout_marginRight="12dp"
                        android:background="@drawable/shape"
                        android:gravity="center"
                        android:hint="blanket cover"
                        android:inputType="number"
                        android:textColor="@android:color/black"
                        android:textColorHint="@color/colorHint"
                        android:textSize="20sp" />
                </LinearLayout>


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">


                        <TextView
                            android:id="@+id/txt10"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginVertical="@dimen/_8sdp"
                            android:text="Face Towel"
                            android:textColor="@color/black"
                            android:textSize="20sp"
                            app:tint="@color/colorWhite" />
                    </LinearLayout>


                    <EditText
                        android:id="@+id/tv_face_towel"
                        android:layout_width="match_parent"
                        android:layout_height="35sp"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="2dp"
                        android:background="@drawable/shape"
                        android:gravity="center"
                        android:hint="face towel"
                        android:inputType="number"
                        android:textColor="@android:color/black"
                        android:textColorHint="@color/colorHint"
                        android:textSize="20sp" />
                </LinearLayout>

            </LinearLayout>


        </LinearLayout>
    </ScrollView>
</LinearLayout>
