                        android:textSize="14sp"
                        android:gravity="center"
                        android:background="@drawable/shape"
                        android:textColorHint="@color/colorHint"
                        android:hint="Pillow"
                        android:textColor="@android:color/black"
                        />

                </LinearLayout>
                <LinearLayout
