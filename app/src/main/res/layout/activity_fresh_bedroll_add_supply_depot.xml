                        android:hint="number of bags"
                        android:layout_marginRight="12dp"
                        android:inputType="number"

                        android:textColor="@android:color/black"
                        android:textColorHint="@color/colorHint"
                        android:textSize="14sp" />
                </LinearLayout>

                <LinearLayout
