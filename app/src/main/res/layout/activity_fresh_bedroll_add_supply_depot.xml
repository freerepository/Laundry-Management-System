                        android:hint="pillow cover"
                        android:inputType="number"
                        android:textColor="@android:color/black"
                        android:textColorHint="@color/colorHint"
                        android:textSize="14sp" />
                </LinearLayout>

            </LinearLayout>

            <LinearLayout
