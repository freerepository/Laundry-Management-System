<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/colorHint"
    android:gravity="center">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/_25sdp"
            android:background="@drawable/bg_corner8"
            android:elevation="@dimen/_8sdp"
            android:gravity="center"
            android:orientation="vertical">

            <RelativeLayout
                android:id="@+id/rl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#00BCD4"
                android:gravity="center_vertical"
                android:paddingVertical="@dimen/_4sdp">

                <TextView
                    android:id="@+id/tv_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:gravity="center"
                    android:text="Edit Package to Laundry"
                    android:textAppearance="@style/Base.TextAppearance.AppCompat.Large"
                    android:textColor="@android:color/white"
                    android:textSize="20sp" />

            </RelativeLayout>

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/_16sdp"
                android:layout_marginTop="@dimen/_16sdp"
                android:background="@drawable/shape_circle"
                android:gravity="center_vertical"
                app:layout_constraintTop_toBottomOf="@+id/rv">

                <EditText
                    android:id="@+id/et_date"
                    android:layout_width="match_parent"
                    android:layout_height="28dp"
                    android:layout_centerVertical="true"
                    android:background="@null"
                    android:gravity="center"
                    android:hint="Select Date"
                    android:inputType="date"
                    android:textColor="@android:color/black"
                    android:textColorHint="@color/black_overlay"
                    android:textSize="14sp" />

                <ImageView
                    android:id="@+id/iv_calender"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="10dp"
                    android:padding="4dp"
                    android:src="@drawable/icon_calendar"
                    app:tint="@color/black" />
            </RelativeLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/_16sdp"
                android:layout_marginTop="@dimen/_16sdp"
                android:background="@drawable/shape_circle"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                app:layout_constraintTop_toBottomOf="@+id/ll_uid">

                <EditText
                    android:id="@+id/et_select_laundry"
                    android:layout_width="match_parent"
                    android:layout_height="28dp"
                    android:layout_centerVertical="true"
                    android:layout_marginLeft="4dp"
                    android:background="@null"
                    android:gravity="center"
                    android:hint="Select Coach"
                    android:textColor="@android:color/black"
                    android:textColorHint="@color/black_overlay"
                    android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/_16sdp"
                android:layout_marginTop="@dimen/_16sdp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                app:layout_constraintTop_toBottomOf="@+id/ll_uid">

                <EditText
                    android:id="@+id/et_select_train"
                    android:layout_width="match_parent"
                    android:layout_height="32dp"
                    android:layout_centerVertical="true"
                    android:layout_marginRight="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/shape_circle"
                    android:focusable="false"
                    android:gravity="center"
                    android:hint="Select Train"
                    android:textColor="@android:color/black"
                    android:textColorHint="@color/black_overlay"
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/et_select_coach"
                    android:layout_width="match_parent"
                    android:layout_height="32dp"
                    android:layout_centerVertical="true"
                    android:layout_marginLeft="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/shape_circle"
                    android:focusable="false"
                    android:gravity="center"
                    android:hint="Select Coach"
                    android:textColor="@android:color/black"
                    android:textColorHint="@color/black_overlay"
                    android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/_16sdp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                app:layout_constraintTop_toBottomOf="@+id/ll_uid">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginVertical="@dimen/_8sdp"
                        android:text="No of Bag"
                        android:textColor="@color/black"
                        android:textSize="10sp"
                        app:tint="@color/colorWhite" />

                    <EditText
                        android:id="@+id/et_no_of_bag"
                        android:layout_width="match_parent"
                        android:layout_height="30sp"
                        android:layout_centerVertical="true"
                        android:layout_marginRight="12dp"
                        android:background="@drawable/shape_circle"
                        android:gravity="center"
                        android:hint="No of Bag"
                        android:inputType="number"
                        android:textColor="@android:color/black"
                        android:textColorHint="@color/colorHint"
                        android:textSize="10sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layout2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/layout3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="2dp"
                        android:orientation="horizontal">


                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginVertical="@dimen/_8sdp"
                            android:layout_marginStart="4dp"
                            android:text="Bed Sheet"
                            android:textColor="@color/black"
                            android:textSize="10sp"
                            app:tint="@color/colorWhite" />
                    </LinearLayout>


                    <EditText
                        android:id="@+id/et_bed_sheet"
                        android:layout_width="match_parent"
                        android:layout_height="30sp"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="2dp"
                        android:background="@drawable/shape_circle"
                        android:gravity="center"
                        android:hint="bed sheet"
                        android:inputType="number"
                        android:textColor="@android:color/black"
                        android:textColorHint="@color/colorHint"
                        android:textSize="10sp" />
                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/_16sdp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                app:layout_constraintTop_toBottomOf="@+id/ll_uid">

                <LinearLayout
                    android:id="@+id/layout5"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/layout6"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">


                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginVertical="@dimen/_8sdp"
                            android:text="Pillow Cover"
                            android:textColor="@color/black"
                            android:textSize="10sp"
                            app:tint="@color/colorWhite" />
                    </LinearLayout>


                    <EditText
                        android:id="@+id/et_pillow_cover"
                        android:layout_width="match_parent"
                        android:layout_height="30dp"
                        android:layout_centerVertical="true"
                        android:layout_marginRight="12dp"
                        android:background="@drawable/shape_circle"
                        android:gravity="center"
                        android:hint="pillow cover"
                        android:inputType="number"
                        android:textColor="@android:color/black"
                        android:textColorHint="@color/colorHint"
                        android:textSize="10sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="2dp"
                        android:orientation="horizontal">


                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginVertical="@dimen/_8sdp"
                            android:layout_marginStart="4dp"
                            android:text="Face Towel"
                            android:textColor="@color/black"
                            android:textSize="10sp"
                            app:tint="@color/colorWhite" />
                    </LinearLayout>


                    <EditText
                        android:id="@+id/et_face_towel"
                        android:layout_width="match_parent"
                        android:layout_height="30sp"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="2dp"
                        android:background="@drawable/shape_circle"
                        android:gravity="center"
                        android:hint="face towel"
                        android:inputType="number"
                        android:textColor="@android:color/black"
                        android:textColorHint="@color/colorHint"
                        android:textSize="10sp" />
                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/_16sdp"
                android:layout_marginTop="@dimen/_1sdp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                app:layout_constraintTop_toBottomOf="@+id/ll_uid">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginVertical="@dimen/_8sdp"
                        android:text="Blanket Cover"
                        android:textColor="@color/black"
                        android:textSize="10sp"
                        app:tint="@color/colorWhite" />

                    <EditText
                        android:id="@+id/et_blanket_cover"
                        android:layout_width="match_parent"
                        android:layout_height="30sp"
                        android:layout_centerVertical="true"
                        android:layout_marginRight="12dp"
                        android:background="@drawable/shape_circle"
                        android:gravity="center"
                        android:hint="blanket cover"
                        android:inputType="number"
                        android:textColor="@android:color/black"
                        android:textColorHint="@color/colorHint"
                        android:textSize="10sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginVertical="@dimen/_8sdp"
                        android:text="Bath Towel"
                        android:textColor="@color/black"
                        android:textSize="10sp"
                        app:tint="@color/colorWhite" />

                    <EditText
                        android:id="@+id/et_bath_towel"
                        android:layout_width="match_parent"
                        android:layout_height="30sp"
                        android:layout_centerVertical="true"
                        android:background="@drawable/shape_circle"
                        android:gravity="center"
                        android:hint="bath towel"
                        android:inputType="number"
                        android:textColor="@android:color/black"
                        android:textColorHint="@color/colorHint"
                        android:textSize="10sp" />
                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/_16sdp"
                android:layout_marginTop="@dimen/_2sdp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                app:layout_constraintTop_toBottomOf="@+id/ll_uid">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginVertical="@dimen/_8sdp"
                        android:text="Blankets"
                        android:textColor="@color/black"
                        android:textSize="10sp"
                        app:tint="@color/colorWhite" />

                    <EditText
                        android:id="@+id/et_blanket"
                        android:layout_width="match_parent"
                        android:layout_height="30sp"
                        android:layout_centerVertical="true"
                        android:background="@drawable/shape_circle"
                        android:gravity="center"
                        android:hint="blankets"
                        android:inputType="number"
                        android:textColor="@android:color/black"
                        android:textColorHint="@color/colorHint"
                        android:textSize="10sp" />
                </LinearLayout>


                <LinearLayout
                    android:id="@+id/layout1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <LinearLayout
                        android:id="@+id/layout"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">


                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginVertical="@dimen/_8sdp"
                            android:text="Total Packets"
                            android:textColor="@color/black"
                            android:textSize="10sp"
                            app:tint="@color/colorWhite" />
                    </LinearLayout>


                    <EditText
                        android:id="@+id/et_total_packet"
                        android:layout_width="match_parent"
                        android:layout_height="30sp"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="2dp"
                        android:background="@drawable/shape_circle"
                        android:gravity="center"
                        android:hint="total packets"
                        android:inputType="number"
                        android:textColor="@android:color/black"
                        android:textColorHint="@color/colorHint"
                        android:textSize="10sp" />
                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/_16sdp"
                android:layout_marginTop="@dimen/_2sdp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                app:layout_constraintTop_toBottomOf="@+id/ll_uid">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginVertical="@dimen/_8sdp"
                        android:text="Remark:"
                        android:textColor="@color/black"
                        android:textSize="12sp"
                        app:tint="@color/colorWhite" />

                    <EditText
                        android:id="@+id/et_remark"
                        android:layout_width="fill_parent"
                        android:layout_height="50sp"
                        android:background="@drawable/shape_circle"
                        android:gravity="top|left"
                        android:hint="Write something...."
                        android:inputType="textEmailAddress|textMultiLine"
                        android:lines="20"
                        android:minLines="5"
                        android:scrollbars="vertical"
                        android:scrollHorizontally="false"
                        android:textColor="@android:color/black"
                        android:textColorHint="@color/colorHint"
                        android:textSize="10sp" />
                    />
                </LinearLayout>


            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_4sdp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/v_negative"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/_30sdp"
                    android:layout_margin="@dimen/_16sdp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_corner8"
                    android:backgroundTint="@android:color/holo_red_dark"
                    android:elevation="@dimen/_2sdp"
                    android:fontFamily="@font/droid_serif"
                    android:gravity="center"
                    android:text="Cancel"
                    android:textColor="@android:color/white" />

                <TextView
                    android:id="@+id/v_positive"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/_30sdp"
                    android:layout_margin="@dimen/_16sdp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_corner8"
                    android:backgroundTint="@color/colorGreen"
                    android:elevation="@dimen/_2sdp"
                    android:fontFamily="@font/droid_serif"
                    android:gravity="center"
                    android:text="Update"
                    android:textColor="@android:color/white" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>