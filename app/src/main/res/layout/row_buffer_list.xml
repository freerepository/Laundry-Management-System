<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="4dp"
    android:paddingBottom="4dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:background="@drawable/btn1"
    android:layout_margin="1dp"
    android:elevation="@dimen/_4sdp"
    android:minHeight="48dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1">
    <TextView
        android:id="@+id/tv_index"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:layout_weight="1"
        android:textSize="12dp"
        android:textAppearance="@android:style/TextAppearance.Medium"
        android:textColor="@android:color/black"
        android:text="1"/>

    <TextView
        android:id="@+id/tv_date"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textSize="12dp"
        android:layout_weight="3"
        android:gravity="center"
        android:textColor="#000000"
        android:layout_margin="2dp"
        android:textAppearance="@android:style/TextAppearance.Medium"
        android:text="date"/>
    <TextView
        android:id="@+id/tv_depot"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textSize="12dp"
        android:layout_weight="2"
        android:gravity="center"
        android:textColor="#000000"
        android:layout_margin="2dp"
        android:textAppearance="@android:style/TextAppearance.Medium"
        android:text="Depot"/>
            <TextView
                android:id="@+id/tv_status"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textSize="12dp"
                android:layout_weight="2"
                android:gravity="center"
                android:textColor="#000000"
                android:layout_margin="2dp"
                android:textAppearance="@android:style/TextAppearance.Medium"
                android:text="Status "/>
          <TextView
          android:id="@+id/tv_reason"
           android:layout_width="0dp"
           android:layout_height="wrap_content"
           android:textSize="12dp"
           android:layout_weight="2"
           android:gravity="center"
           android:textColor="#000000"
           android:layout_margin="2dp"
           android:textAppearance="@android:style/TextAppearance.Medium"
           android:text="Reason "/>



    <TextView
        android:id="@+id/tv_Total_Items"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textSize="12dp"
        android:layout_weight="3"
        android:visibility="gone"
        android:textColor="#000000"
        android:layout_margin="2dp"
        android:gravity="center"
        android:textAppearance="@android:style/TextAppearance.Medium"
        android:text="Total Items"/>


        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/background"
            android:layout_weight="1">

            <TextView
                android:id="@+id/tv_b2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textSize="10dp"
                android:layout_weight="2"
                android:gravity="end|center_horizontal"
                android:textColor="#000000"
                android:layout_margin="2dp"
                android:textAppearance="@android:style/TextAppearance.Medium"
                android:text="BS :"/>
            <TextView
                android:id="@+id/tv_bed_sheet"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textSize="10dp"
                android:layout_weight="2"
                android:textColor="#000000"
                android:layout_margin="2dp"
                android:textAppearance="@android:style/TextAppearance.Medium"
                android:text="0"/>

            <TextView
                android:id="@+id/tv_b4"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textSize="10dp"
                android:layout_weight="2"
                android:gravity="end|center_horizontal"
                android:textColor="#000000"
                android:layout_margin="2dp"
                android:textAppearance="@android:style/TextAppearance.Medium"
                android:text="Pillow :"/>
            <TextView
                android:id="@+id/tv_pillow"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textSize="10dp"
                android:layout_weight="1.8"
                android:textColor="#000000"
                android:layout_margin="2dp"
                android:textAppearance="@android:style/TextAppearance.Medium"
                android:text="0"/>
            <TextView
                android:id="@+id/tv_b8"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textSize="10dp"
                android:layout_weight="2"
                android:textColor="#000000"
                android:layout_margin="2dp"
                android:gravity="end|center_horizontal"
                android:textAppearance="@android:style/TextAppearance.Medium"
                android:text="PC :"/>
            <TextView
                android:id="@+id/tv_pillow_cover"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textSize="10dp"
                android:layout_weight="2"
                android:textColor="#000000"
                android:layout_margin="2dp"
                android:textAppearance="@android:style/TextAppearance.Medium"
                android:text="0"/>

        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/background"
            android:layout_weight="1">

            <TextView
                android:id="@+id/tv_pt"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textSize="10dp"
                android:layout_weight="2.2"
                android:gravity="end|center_horizontal"
                android:textColor="#000000"
                android:layout_margin="2dp"
                android:textAppearance="@android:style/TextAppearance.Medium"
                android:text="Blanket :"/>
            <TextView
                android:id="@+id/tv_blanket"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textSize="10dp"
                android:layout_weight="2"
                android:textColor="#000000"
                android:layout_margin="2dp"
                android:textAppearance="@android:style/TextAppearance.Medium"
                android:text="0"/>
            <TextView
                android:id="@+id/tv_p6"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textSize="10dp"
                android:layout_weight="2.1"
                android:gravity="end|center_horizontal"
                android:textColor="#000000"
                android:layout_margin="2dp"
                android:textAppearance="@android:style/TextAppearance.Medium"
                android:text="BC :"/>
            <TextView
                android:id="@+id/tv_blanket_cover"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textSize="10dp"
                android:layout_weight="2"
                android:textColor="#000000"
                android:layout_margin="2dp"
                android:textAppearance="@android:style/TextAppearance.Medium"
                android:text="0"/>

            <TextView
                android:id="@+id/tv_p7"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textSize="10dp"
                android:layout_weight="2"
                android:textColor="#000000"
                android:layout_margin="2dp"
                android:gravity="end|center_horizontal"
                android:textAppearance="@android:style/TextAppearance.Medium"
                android:text="HT :"/>
            <TextView
                android:id="@+id/tv_hand_towel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textSize="10dp"
                android:layout_weight="2"
                android:textColor="#000000"
                android:layout_margin="2dp"
                android:textAppearance="@android:style/TextAppearance.Medium"
                android:text="0"/>


        </LinearLayout>
    </LinearLayout>
</LinearLayout>
