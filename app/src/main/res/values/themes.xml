<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.LaundryManagement" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">#0080FF</item>
        <item name="colorPrimaryVariant">#0080FF</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/colorAccent</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
        <!-- Customize your theme here. -->

    </style>

    <style name="CalenderTheme" parent="Theme.AppCompat.Light.Dialog">
        <item name="colorAccent">@color/colorPrimary</item>
    </style>

    <style name="Dialog" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/color_dialog_bg</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
    </style>

    <style name="AppTheme.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar" />

    <style name="AppTheme.PopupOverlay" parent="ThemeOverlay.AppCompat.Light" />

    <style name="mySpinnerTextColor">
        <item name="android:textColor">@color/colorRed</item>
    </style>

    <style name="text1">
        <item name="android:textColor">@color/black</item>
    </style>

    <style name="textBoth">
        <item name="android:textColor">@color/white</item>
        <item name="android:textColorHint">@color/white</item>
    </style>
    <style name="textBothBlack">
        <item name="android:textColor">#403F3F</item>
        <item name="android:textColorHint">#403F3F</item>
    </style>
    <style name="border">
        <item name="android:background">@drawable/shape</item>
    </style>


    <style name="SCREEN">
        <item name="android:background">#fff</item>
    </style>

    <style name="Text">
        <item name="android:textColor">#403F3F</item>
        <item name="android:textColorHint">#403F3F</item>
    </style>

    <style name="TextdarkWhite">
        <item name="android:textColor">#403F3F</item>
    </style>


    <style name="background">
        <item name="android:background">@drawable/btn1</item>
    </style>


</resources>